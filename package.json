{
  "name": "amp-csr-portal",
  "private": true,
  "version": "1.0.0",
  "description": "CSR Portal for AMP car wash membership platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "npm run build -w @amp-csr/shared",
    "dev": "concurrently -n shared,api,web -c gray,red,cyan \"npm run dev -w @amp-csr/shared\" \"npm run start:dev -w @amp-csr/api\" \"npm run dev -w @amp-csr/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "author": "Andrew Jarnagin",
  "license": "UNLICENSED",
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  }
}
