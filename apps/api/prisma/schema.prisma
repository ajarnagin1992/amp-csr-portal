generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum CsrUserStatus {
  ACTIVE
  DISABLED
}

enum MobileUserStatus {
  ACTIVE
  DISABLED
}

enum PlanStatus {
  ACTIVE
  DISABLED
}

enum PurchaseType {
  SUBSCRIPTION
  SINGLE_WASH
}

enum PurchaseStatus {
  SUCCESS
  FAILURE
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  OVERDUE
  CANCELLED
  TRANSFERRED
}

model CsrUser {
  id           Int           @id @default(autoincrement())
  username     String
  email        String        @unique
  passwordHash String        @map("password_hash")
  status       CsrUserStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")

  sessions CsrSession[]

  @@map("csr_users")
}

model CsrSession {
  id        Int      @id @default(autoincrement())
  csrUserId Int      @map("csr_user_id")
  // SHA-256 of the cookie token; the raw token is never stored.
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  csrUser CsrUser @relation(fields: [csrUserId], references: [id], onDelete: Cascade)

  @@index([csrUserId])
  @@map("csr_sessions")
}

model MobileUser {
  id          Int              @id @default(autoincrement())
  firstName   String           @map("first_name")
  lastName    String           @map("last_name")
  email       String           @unique
  phone       String
  status      MobileUserStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at")
  lastUpdated DateTime         @updatedAt @map("last_updated")

  vehicles  Vehicle[]
  purchases Purchase[]

  @@map("mobile_users")
}

model Vehicle {
  id            Int      @id @default(autoincrement())
  mobileUserId  Int      @map("mobile_user_id")
  licensePlate  String   @map("license_plate")
  state         String
  make          String
  model         String
  year          Int
  createdAt     DateTime @default(now()) @map("created_at")

  mobileUser    MobileUser     @relation(fields: [mobileUserId], references: [id])
  purchases     Purchase[]
  subscriptions Subscription[]

  @@map("vehicles")
}

model Plan {
  id          Int        @id @default(autoincrement())
  name        String
  description String     @default("")
  price       Int
  status      PlanStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at")
  lastUpdated DateTime   @updatedAt @map("last_updated")

  subscriptions Subscription[]

  @@map("plans")
}

model Purchase {
  id             Int            @id @default(autoincrement())
  mobileUserId   Int            @map("mobile_user_id")
  vehicleId      Int            @map("vehicle_id")
  subscriptionId Int?           @map("subscription_id")
  type           PurchaseType
  status         PurchaseStatus
  amount         Int
  description    String
  createdAt      DateTime       @default(now()) @map("created_at")

  mobileUser   MobileUser    @relation(fields: [mobileUserId], references: [id])
  vehicle      Vehicle       @relation(fields: [vehicleId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@map("purchases")
}

model Subscription {
  id              Int                @id @default(autoincrement())
  vehicleId       Int                @map("vehicle_id")
  planId          Int                @map("plan_id")
  status          SubscriptionStatus @default(ACTIVE)
  nextBillingDate DateTime           @map("next_billing_date")
  createdAt       DateTime           @default(now()) @map("created_at")
  lastUpdated     DateTime           @updatedAt @map("last_updated")

  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id])
  plan      Plan       @relation(fields: [planId], references: [id])
  purchases Purchase[]

  @@index([vehicleId, createdAt])
  // A vehicle can have at most one live (ACTIVE or OVERDUE) subscription.
  @@unique([vehicleId], where: raw("status IN ('ACTIVE', 'OVERDUE')"), map: "subscriptions_vehicle_id_live_key")
  @@map("subscriptions")
}
